# Optional: add a key only if you want OpenAQ monitoring-station observations.
# Create a free OpenAQ API key at https://explore.openaq.org/register
OPENAQ_API_KEY=YOUR_Openaq_api_key

# Optional. Override if you operate a compliant replacement geocoder.
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search

# Optional. Defaults to http://localhost:3000
PORT=3000
